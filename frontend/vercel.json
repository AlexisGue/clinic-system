{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://clinic-system-tt2i.onrender.com/api/:path*"
    },
    {
      "source": "/sanctum/:path*",
      "destination": "https://clinic-system-tt2i.onrender.com/sanctum/:path*"
    },
    {
      "source": "/up",
      "destination": "https://clinic-system-tt2i.onrender.com/up"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
